# Supabase project URL and publishable/anon key. These are public client identifiers,
# not service-role secrets. Never expose a Supabase service-role key in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public HTTPS origin for verification and password-reset links in hosted environments.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only 32-byte AES-256 key for encrypting per-user Tacticus API keys.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
TACTICUS_CREDENTIAL_ENCRYPTION_KEY=
